  {
    "id": "fn_log",
    "type": "function",
    "z": "tab_semaforo",
    "name": "Registrar evento",
    "func": "const lista = flow.get('eventos') || [];\nconst hora = new Date().toLocaleTimeString('pt-BR', { timeZone: 'America/Sao_Paulo' });\nlista.unshift(hora + ' - ' + msg.payload);\nif (lista.length > 12) lista.length = 12;\nflow.set('eventos', lista);\nreturn { payload: lista };",
