  {
    "id": "fn_angulo",
    "type": "function",
    "z": "tab_semaforo",
    "name": "Interpretar ângulo",
    "func": "const v = Number(msg.payload);\nif (isNaN(v) || v < 0 || v > 180) {\n    node.warn('Angulo invalido: ' + msg.payload);\n    return null;\n}\nlet situacao = 'EM MOVIMENTO';\nif (v <= 5) situacao = 'FECHADA';\nelse if (v >= 85) situacao = 'ABERTA';\n// so registra no log quando a situacao muda, para nao poluir a lista\nconst anterior = flow.get('situacaoCatraca');\nflow.set('situacaoCatraca', situacao);\nconst log = situacao !== anterior ? { payload: 'Catraca: ' + situacao + ' (' + v + '°)' } : null;\nreturn [\n    { payload: v },\n    { payload: v, topic: 'Ângulo da catraca (graus)' },\n    { payload: situacao },\n    log\n];",
    "outputs": 4,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 400,
    "y": 260,
    "wires": [
      [
        "ga_ang"
      ],
      [
        "ch_ang"
      ],
      [
        "tx_cat"
      ],
      [
        "fn_log"
      ]
    ]
  },
