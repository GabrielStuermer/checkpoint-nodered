  {
    "id": "fn_estado",
    "type": "function",
    "z": "tab_semaforo",
    "name": "Interpretar fase",
    "func": "const v = Number(msg.payload);\nif (![0, 1, 2].includes(v)) {\n    node.warn('Fase invalida: ' + msg.payload);\n    return null;\n}\nconst nomes = ['VERDE', 'AMARELO', 'VERMELHO'];\nglobal.set('estado', v);\nreturn [\n    { payload: v, nome: nomes[v] },\n    { payload: v, topic: 'Fase (0=verde, 1=amarelo, 2=vermelho)' },\n    { payload: 'Semáforo: ' + nomes[v] }\n];",
    "outputs": 3,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 400,
    "y": 120,
    "wires": [
      [
        "ui_sem"
      ],
      [
        "ch_fase"
      ],
      [
        "fn_log"
      ]
    ]
  },
  {
    "id": "ui_sem",
    "type": "ui_template",
    "z": "tab_semaforo",
    "group": "g_sem",
    "name": "Semáforo visual",
    "order": 1,
    "width": "6",
    "height": "6",
    "format": "<style>\n.sem{display:flex;flex-direction:column;align-items:center;gap:10px;padding:14px;background:#222;border-radius:18px;width:110px;margin:4px auto}\n.luz{width:70px;height:70px;border-radius:50%;background:#555;opacity:.3;transition:all .3s}\n.luz.on.vermelho{background:#e74c3c;opacity:1;box-shadow:0 0 28px #e74c3c}\n.luz.on.amarelo{background:#f1c40f;opacity:1;box-shadow:0 0 28px #f1c40f}\n.luz.on.verde{background:#2ecc71;opacity:1;box-shadow:0 0 28px #2ecc71}\n.nome{text-align:center;font-weight:bold;font-size:18px;margin-top:4px}\n</style>\n<div class='sem'>\n  <div class='luz vermelho' ng-class='{on: msg.payload===2}'></div>\n  <div class='luz amarelo' ng-class='{on: msg.payload===1}'></div>\n  <div class='luz verde' ng-class='{on: msg.payload===0}'></div>\n</div>\n<div class='nome'>{{msg.nome || 'Aguardando dados...'}}</div>",
    "storeOutMessages": true,
    "fwdInMessages": false,
    "resendOnRefresh": true,
    "templateScope": "local",
    "className": "",
    "x": 650,
    "y": 80,
    "wires": [
      []
    ]
